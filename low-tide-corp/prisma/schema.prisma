// Low Tide Corp — data model.
// Postgres (e.g. free Neon.tech) so it works on serverless hosts like Vercel,
// whose filesystem is ephemeral and can't hold a SQLite file across requests.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Idea {
  id         String   @id @default(cuid())
  title      String
  oneLiner   String
  audience   String?
  budget     String?
  dontDo     String?
  status     String   @default("active") // active | archived
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  workdays   Workday[]
  briefs     CompanyBrief[]
}

model Workday {
  id          String     @id @default(cuid())
  ideaId      String?
  idea        Idea?      @relation(fields: [ideaId], references: [id], onDelete: SetNull)
  date        String     // YYYY-MM-DD
  slot        String     @default("morning") // morning | night
  status      String     @default("queued") // queued | running | done | failed
  agenda      String? // JSON: AgendaTask[]
  summary     String?
  criticScore Int?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  artifacts   Artifact[]
  runLogs     RunLog[]
  actionItems ActionItem[]

  @@unique([date, slot, ideaId])
  @@index([date])
  @@index([ideaId])
}

model ActionItem {
  id          String   @id @default(cuid())
  workdayId   String
  workday     Workday  @relation(fields: [workdayId], references: [id], onDelete: Cascade)
  title       String
  status      String   @default("open") // open | done | blocked
  evidence    String?
  completedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
  @@index([workdayId])
}

model Artifact {
  id        String   @id @default(cuid())
  workdayId String
  workday   Workday  @relation(fields: [workdayId], references: [id], onDelete: Cascade)
  agent     String // orchestrator | researcher | product | builder | growth | operator | critic
  type      String // agenda | research | spec | copy | plan | critique | brief
  body      String // JSON — the structured, schema-validated output
  markdown  String // human-readable rendering of body
  citations String? // JSON: {title,url}[]
  error     String?
  createdAt DateTime @default(now())

  @@index([workdayId])
}

model CompanyBrief {
  id            String   @id @default(cuid())
  ideaId        String?
  idea          Idea?    @relation(fields: [ideaId], references: [id], onDelete: SetNull)
  problem       String
  icp           String
  offer         String
  bets          String // JSON string[]
  killedIdeas   String // JSON string[]
  openQuestions String // JSON string[]
  version       Int      @default(1)
  updatedAt     DateTime @updatedAt

  @@index([ideaId])
}

model RunLog {
  id        String   @id @default(cuid())
  workdayId String?
  workday   Workday? @relation(fields: [workdayId], references: [id], onDelete: Cascade)
  agent     String?
  level     String // info | error
  message   String
  tokensIn  Int?
  tokensOut Int?
  createdAt DateTime @default(now())

  @@index([workdayId])
}

model Settings {
  id               String @id @default("singleton")
  provider         String @default("gemini")
  model            String @default("gemini-3.6-flash")
  timezone         String @default("America/Los_Angeles")
  maxDollarsPerDay Float  @default(2.0)
  agentsOn         String @default("{\"researcher\":true,\"product\":true,\"builder\":true,\"growth\":true,\"operator\":true}")
  ownerName        String @default("Liam Thompson")
  ownerEmail       String @default("liambt20@gmail.com")
}
