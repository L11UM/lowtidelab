# Database — free Postgres works great here (e.g. https://neon.tech, no credit card).
# Paste the connection string Neon gives you.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# LLM provider: "gemini" (free tier, default), "openai", or "anthropic"
LLM_PROVIDER="gemini"
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.6-flash"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-3-5-sonnet-20241022"

# Random server-only secret used to authenticate the daily Vercel Cron request.
CRON_SECRET=""

# Session auth for the local app. A fallback is used in development if these are blank.
AUTH_SECRET="low-tide-corp-dev-secret"
ADMIN_PASSWORD="low-tide-corp-local"

# Owner metadata (do not change — single owner, no invented co-founders)
OWNER_NAME="Liam Thompson"
OWNER_EMAIL="liambt20@gmail.com"

# Optional: where profits would eventually be sent (not wired to any payment
# rail in v1 — no real revenue exists yet, this is just a config placeholder).
BTC_PAYOUT_ADDRESS=""
